# ===========================================
# LoveIQ Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# Site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------
# Supabase (waitlist storage)
# -------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# Resend (transactional emails)
# -------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM=LoveIQ <hello@send.loveiq.org>
RESEND_REPLY_TO=hello@loveiq.org

# -------------------------------------------
# Stripe (billing, server/client split)
# -------------------------------------------
# Safe for browser only when prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_your_publishable_key
# Server-only secret, never expose to the client
STRIPE_SECRET_KEY=sk_your_secret_key
# Feature flag: keep false until live checkout should create real Stripe sessions
STRIPE_CHECKOUT_ENABLED=false
# Server-only webhook signing secret for Stripe event verification
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Price IDs for report purchase plans (server-only)
STRIPE_PRICE_ID_ESSENTIALS=price_essentials_placeholder
STRIPE_PRICE_ID_FULL_REPORT=price_full_report_placeholder
STRIPE_PRICE_ID_ALL_REPORTS=price_all_reports_placeholder

# -------------------------------------------
# Google reCAPTCHA v2 (contact form)
# -------------------------------------------
# Get keys at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# -------------------------------------------
# Slack Webhooks (notifications)
# -------------------------------------------
# Optional: Leave empty to disable Slack notifications
SLACK_WAITLIST_WEBHOOK_URL=
SLACK_CONTACT_WEBHOOK_URL=
SLACK_SURVEY_WEBHOOK_URL=

# -------------------------------------------
# Staging Environment
# -------------------------------------------
# Password gate for the staging deployment (leave empty to disable)
STAGING_PASSWORD=

# -------------------------------------------
# Supabase Auth (admin panel)
# -------------------------------------------
# Public keys for Supabase Auth SDK (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -------------------------------------------
# Admin Panel (DEPRECATED — replaced by Supabase Auth)
# -------------------------------------------
# ADMIN_PASSWORD is no longer used. Admin access is managed via
# the admin_users table in Supabase + magic link authentication.

# -------------------------------------------
# Survey Close Protection
# -------------------------------------------
# Password required to close/pause the survey (server-side check)
SURVEY_CLOSE_PASSWORD=

# -------------------------------------------
# Contact Form
# -------------------------------------------
CONTACT_TO_EMAIL=hello@loveiq.org

# -------------------------------------------
# Google Tag Manager (optional — leave empty to use direct gtag.js only)
# -------------------------------------------
NEXT_PUBLIC_GTM_ID=

# -------------------------------------------
# Logging (optional)
# -------------------------------------------
# Controls pino log level (default: "info")
# Options: fatal, error, warn, info, debug, trace
# LOG_LEVEL=info

# ===========================================
# LoveIQ Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# Site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------
# Supabase (waitlist storage)
# -------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# Resend (transactional emails)
# -------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM=LoveIQ <hello@send.loveiq.org>
RESEND_REPLY_TO=hello@loveiq.org

# -------------------------------------------
# Stripe (billing, server/client split)
# -------------------------------------------
# Paywall is ALWAYS enforced on /report — locked sections show the pricing modal.
# Sandbox / test-mode keys (pk_test_/sk_test_) work for full end-to-end flow:
# Stripe lets you confirm with test card 4242 4242 4242 4242, any future date, any CVC.
# Webhook fulfillment runs in test mode the same as live — buying the essentials
# plan unlocks ONLY essentials sections; full_report unlocks essentials+full;
# all_reports unlocks everything across all archetypes.
#
# To run real checkout (sandbox or live):
#   STRIPE_CHECKOUT_ENABLED=true
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   (or pk_live_... in prod)
#   STRIPE_SECRET_KEY=sk_test_...                    (or sk_live_... in prod)
#   STRIPE_WEBHOOK_SECRET=whsec_...                  (per Stripe dashboard endpoint)
#   NEXT_PUBLIC_STRIPE_CHECKOUT_PREVIEW_MODE=false   (true only shows a "preview" banner)
#
# Webhook endpoint to register in Stripe dashboard:
#   https://<your-domain>/api/stripe/webhook
# Subscribe to events:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   checkout.session.expired
#   charge.refunded
#   charge.dispute.created
#   charge.dispute.closed
#
# Local sandbox testing: install Stripe CLI, run
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and use the printed whsec_... as STRIPE_WEBHOOK_SECRET.
#
# Pricing is dynamic (lib/pricing/reportPricing). No Stripe Price IDs are used.

# Safe for browser only when prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_your_publishable_key
# Server-only secret, never expose to the client
STRIPE_SECRET_KEY=sk_your_secret_key
# Feature flag: keep false in dev without keys; set true in any env that should
# create real Stripe sessions (sandbox or live).
STRIPE_CHECKOUT_ENABLED=false
# Browser-visible preview banner. Keep false unless you specifically want users
# to see "purchases do not unlock yet" copy. Sandbox + live both run real flow.
NEXT_PUBLIC_STRIPE_CHECKOUT_PREVIEW_MODE=false
# Server-only webhook signing secret for Stripe event verification
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -------------------------------------------
# Google reCAPTCHA v2 (contact form)
# -------------------------------------------
# Get keys at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# -------------------------------------------
# Slack Webhooks (notifications)
# -------------------------------------------
# Optional: Leave empty to disable Slack notifications
SLACK_WAITLIST_WEBHOOK_URL=
SLACK_CONTACT_WEBHOOK_URL=
SLACK_SURVEY_WEBHOOK_URL=

# -------------------------------------------
# Cron Secret
# -------------------------------------------
# Shared secret for /api/cron/* endpoints (e.g. survey-paused reminder).
# Schedule in Vercel / external scheduler: GET with
#   Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# -------------------------------------------
# Staging Environment
# -------------------------------------------
# Password gate for the staging deployment (leave empty to disable)
STAGING_PASSWORD=

# -------------------------------------------
# Supabase Auth (admin panel)
# -------------------------------------------
# Public keys for Supabase Auth SDK (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -------------------------------------------
# Admin Panel (DEPRECATED — replaced by Supabase Auth)
# -------------------------------------------
# ADMIN_PASSWORD is no longer used. Admin access is managed via
# the admin_users table in Supabase + magic link authentication.

# -------------------------------------------
# Survey Close Protection
# -------------------------------------------
# Password required to close/pause the survey (server-side check)
SURVEY_CLOSE_PASSWORD=

# -------------------------------------------
# Contact Form
# -------------------------------------------
CONTACT_TO_EMAIL=hello@loveiq.org

# -------------------------------------------
# Google Tag Manager (optional — leave empty to use direct gtag.js only)
# -------------------------------------------
NEXT_PUBLIC_GTM_ID=

# -------------------------------------------
# Logging (optional)
# -------------------------------------------
# Controls pino log level (default: "info")
# Options: fatal, error, warn, info, debug, trace
# LOG_LEVEL=info

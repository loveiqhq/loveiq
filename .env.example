# ===========================================
# LoveIQ Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# Site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------
# PostHog (browser analytics)
# -------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -------------------------------------------
# Supabase (survey + admin storage)
# -------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# Upstash Redis / Vercel KV (rate limiting)
# -------------------------------------------
# Optional: Without these, rate limiting falls back to in-memory (per-instance)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# -------------------------------------------
# Resend (transactional emails)
# -------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM=LoveIQ <hello@send.loveiq.org>
RESEND_REPLY_TO=hello@loveiq.org
# Resend Audience that opted-in marketing recipients (Q16015 = "Yes") are
# pushed to. Create the audience in the Resend dashboard → Audiences → New
# Audience. When unset, the audience push is skipped and a warning is logged.
RESEND_AUDIENCE_ID=
# Base URL that EMAIL <img> tags use for their src (logo + testimonial photos).
# Gmail and others may strip remote images whose host doesn't align with the
# sending domain (Resend flags this as "Host images on the sending domain"),
# so logos silently fail for some recipients. Set this to a host aligned with
# the sending domain — e.g. https://send.loveiq.org — but ONLY after that host
# actually serves the /public assets (add it to the Vercel project first, or
# every email image 404s). When unset, falls back to NEXT_PUBLIC_SITE_URL, so
# behaviour is unchanged. Links (CTAs) always stay on NEXT_PUBLIC_SITE_URL.
EMAIL_IMAGE_BASE_URL=

# -------------------------------------------
# Stripe (billing, server/client split)
# -------------------------------------------
# Paywall is ALWAYS enforced on /report — locked sections show the pricing modal.
# Sandbox / test-mode keys (pk_test_/sk_test_) work for full end-to-end flow:
# Stripe lets you confirm with test card 4242 4242 4242 4242, any future date, any CVC.
# Webhook fulfillment runs in test mode the same as live — buying the essentials
# plan unlocks ONLY essentials sections; full_report unlocks essentials+full;
# all_reports unlocks everything across all archetypes.
#
# To run real checkout (sandbox or live):
#   STRIPE_CHECKOUT_ENABLED=true
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   (or pk_live_... in prod)
#   STRIPE_SECRET_KEY=sk_test_...                    (or sk_live_... in prod)
#   STRIPE_WEBHOOK_SECRET=whsec_...                  (per Stripe dashboard endpoint)
#
# Webhook endpoint to register in Stripe dashboard:
#   https://<your-domain>/api/stripe/webhook
# Subscribe to events:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   checkout.session.expired
#   charge.refunded
#   charge.dispute.created
#   charge.dispute.closed
#
# Local sandbox testing: install Stripe CLI, run
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and use the printed whsec_... as STRIPE_WEBHOOK_SECRET.
#
# Pricing is dynamic (lib/pricing/reportPricing). No Stripe Price IDs are used.

# Safe for browser only when prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_your_publishable_key
# Server-only secret, never expose to the client
STRIPE_SECRET_KEY=sk_your_secret_key
# Feature flag: keep false in dev without keys; set true in any env that should
# create real Stripe sessions (sandbox or live).
STRIPE_CHECKOUT_ENABLED=false
# Server-only webhook signing secret for Stripe event verification
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# T-01: webhook livemode guard. Set to "true" on production Vercel projects
# pointing at Stripe live mode; leave unset or "false" in dev/sandbox.
# Webhooks whose event.livemode does NOT match this env are refused, with
# a Slack ops alert. Prevents test events from silently fulfilling against
# prod data (and vice versa).
STRIPE_LIVE_MODE=false
# Stripe Coupon IDs used by the nurture-sequence cron to mint per-user
# Promotion Codes at the 30h / 54h reminder stages. Create the underlying
# coupons once in Stripe Dashboard (Products → Coupons), see
# .planning/codebase/STRIPE-COUPONS.md for the exact setup.
STRIPE_COUPON_50=nurture_50
STRIPE_COUPON_75=nurture_75
# 100%-off Stripe Coupon ID used by the admin "grant post-call 100% coupon"
# action (after a 20-min call) to mint a one-time code that unlocks the full
# report for free. Create a 100%-off coupon in Stripe Dashboard → Coupons.
STRIPE_COUPON_100=nurture_100

# -------------------------------------------
# Calendly webhook (78h "book a call" nurture stage)
# -------------------------------------------
# Signing key from the Calendly v2 webhook subscription. Used by
# /api/calendly/webhook to verify invitee.created / invitee.canceled events and
# record them in booking_event. Leave unset until the subscription exists — the
# webhook returns 503 (safe no-op) without it. Create the subscription via the
# Calendly API pointing at https://www.loveiq.org/api/calendly/webhook for
# invitee.created + invitee.canceled, then paste the returned signing key here.
CALENDLY_WEBHOOK_SECRET=

# -------------------------------------------
# Google reCAPTCHA v2 (contact form)
# -------------------------------------------
# Get keys at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# -------------------------------------------
# Slack Webhooks (notifications)
# -------------------------------------------
# Optional: Leave empty to disable Slack notifications
SLACK_CONTACT_WEBHOOK_URL=
SLACK_SURVEY_WEBHOOK_URL=
SLACK_PAYMENTS_WEBHOOK_URL=
# Ops/alerts channel: 5xx errors, cron failures, Stripe disputes/refunds,
# circuit-breaker state, admin login, abuse signals, daily digest, etc.
SLACK_OPS_WEBHOOK_URL=

# OPTIONAL - live-updating survey notifications. Incoming webhooks cannot edit a
# message after posting, so the per-user journey ping was frozen at the instant of
# submission: its progress rail could only ever show step 1 of 5, and the pricing
# arm read "Not recorded" because no quote exists yet. With a bot token the message
# is posted via chat.postMessage and then EDITED as the person opens their report,
# reaches checkout and pays.
#
# Needs BOTH values, and degrades to the previous webhook behaviour without them.
# Create a Slack app, add the `chat:write` bot scope, install it to the workspace,
# invite it to the channel, then paste the bot token (xoxb-...) and the channel ID
# (the C0... value in the channel's "Copy link", NOT the #name).
SLACK_BOT_TOKEN=
SLACK_JOURNEY_CHANNEL_ID=
# One-shot catch-up that re-posts the last 7 days of survey notifications in the
# current format (see /api/cron/journey-backfill). Leave UNSET. Set to `true`
# only while running the catch-up, then remove it again — it is the only thing
# stopping that route from posting; its cron schedule is annual and exists purely
# so the Vercel dashboard shows a Run button.
JOURNEY_BACKFILL_ENABLED=

# -------------------------------------------
# Cron Secret
# -------------------------------------------
# Shared secret for /api/cron/* endpoints (e.g. survey-paused reminder).
# Schedule in Vercel / external scheduler: GET with
#   Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# Optional. Wall-clock budget (ms) for the nurture-sequence cron loop: it stops
# starting new candidates past this and defers the rest to the next hourly run,
# keeping the function under its 60s maxDuration. Default 42000. Raise only if
# you also raise maxDuration in vercel.json + the route. Do NOT set 0 to pause —
# 0 silently defers ALL sends; use the nurture_sequence kill switch to pause.
NURTURE_TIME_BUDGET_MS=

# Gates the 78h nurture stage (20-min call invite -> Calendly). PAUSED by default
# (unset) — no product person to take the calls. The other 4 nurture stages always
# run. Resume needs BOTH this set to true AND NURTURE_78H_CALENDLY_URL (below).
NURTURE_78H_CALL_ENABLED=

# Operator Calendly booking link for the 78h call invite (whoever takes the
# 20-min calls). Read at send time — flip without a redeploy. The 78h stage stays
# paused unless this is set too, so no dead/empty booking link is ever sent.
# e.g. https://calendly.com/<handle>/20min
NURTURE_78H_CALENDLY_URL=

# Safety flag for the destructive data-retention purge cron
# (/api/cron/purge-old-data). POSTPONED: left unset (disabled) until the
# product has more customers + data old enough to trim. The route is a no-op
# unless this is exactly "true" AND the cron is re-added to vercel.json.
PURGE_OLD_DATA_ENABLED=

# -------------------------------------------
# Email Deliverability
# -------------------------------------------
# 32-byte random hex string used to sign tamper-proof unsubscribe tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# Webhook signing secret from Resend dashboard → Webhooks → Signing Secret (whsec_...)
# Used by /api/resend/webhook to verify bounce/complaint events.
RESEND_WEBHOOK_SECRET=

# -------------------------------------------
# Report Share Verification
# -------------------------------------------
# HMAC secret (>=16 chars) for stateless share-recipient cookies. Recipients
# of a shared report prove identity by typing the invited email; on match we
# issue a 1-year HMAC-signed cookie. Falls back to SUPABASE_SERVICE_ROLE_KEY
# when unset, but a dedicated secret is preferred so rotating the service
# role doesn't invalidate every share access.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_VERIFY_SECRET=

# HMAC secret (≥16 chars) that signs the PNG-chart URLs embedded in funnel-digest
# Slack messages. Slack's image proxy is anonymous, so authenticity proof must
# travel in the URL. Falls back to SHARE_VERIFY_SECRET, then to
# SUPABASE_SERVICE_ROLE_KEY when unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STRATEGY_DIGEST_SIGNING_SECRET=

# -------------------------------------------
# Staging Environment
# -------------------------------------------
# Password gate for the staging deployment (leave empty to disable)
STAGING_PASSWORD=

# -------------------------------------------
# Supabase Auth (admin panel)
# -------------------------------------------
# Public keys for Supabase Auth SDK (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -------------------------------------------
# Admin Panel (DEPRECATED — replaced by Supabase Auth)
# -------------------------------------------
# ADMIN_PASSWORD is no longer used. Admin access is managed via
# the admin_users table in Supabase + magic link authentication.

# -------------------------------------------
# Survey Close Protection
# -------------------------------------------
# Password required to close/pause the survey (server-side check)
SURVEY_CLOSE_PASSWORD=

# -------------------------------------------
# Contact Form
# -------------------------------------------
CONTACT_TO_EMAIL=hello@loveiq.org

# -------------------------------------------
# Google Tag Manager (optional — leave empty to use direct gtag.js only)
# -------------------------------------------
NEXT_PUBLIC_GTM_ID=

# -------------------------------------------
# GA4 Measurement Protocol (server-side purchase tracking)
# -------------------------------------------
# API secret for sending the `purchase` event server-side from the Stripe webhook,
# so GA4's purchase count matches real payments (the client-side event is lossy —
# ad blockers, closed tabs, consent). Create at:
# GA4 Admin → Data Streams → (web stream) → Measurement Protocol API secrets.
# When unset, server-side purchase tracking is skipped (no error). Consent-gated.
GA4_API_SECRET=
# Optional override; defaults to the web-stream ID hardcoded in app/layout.tsx.
# GA4_MEASUREMENT_ID=G-QTYY69L46N

# -------------------------------------------
# Logging (optional)
# -------------------------------------------
# Controls pino log level (default: "info")
# Options: fatal, error, warn, info, debug, trace
# LOG_LEVEL=info

# -------------------------------------------
# Trustpilot (optional — review widget)
# -------------------------------------------
# MASTER SWITCH. Off by default: ALL on-site Trustpilot UI (landing section +
# report pricing modals + bootstrap script) stays hidden until this is exactly
# "true". Turn on only once enough reviews have landed on Trustpilot. The code
# stays in place; this just toggles visibility (no deploy-time code change).
NEXT_PUBLIC_TRUSTPILOT_ENABLED=
# Replaces the on-site testimonials. The cookieless static rating block always
# renders; the live interactive widget loads only after cookie consent
# (cookieyes-functional) AND when a Business Unit ID is set. Find the Business
# Unit ID in Trustpilot Business → Integrations → TrustBox (the
# data-businessunit-id on any embed code).
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
# Your review domain (e.g. loveiq.org) — builds the public profile link.
NEXT_PUBLIC_TRUSTPILOT_DOMAIN=
# Optional TrustBox template overrides (defaults: Review Carousel + Micro Combo).
# NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID_CAROUSEL=
# NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID_MICRO=
# Optional static-block numbers — shown ONLY if both are set (never fabricated).
# NEXT_PUBLIC_TRUSTPILOT_SCORE=
# NEXT_PUBLIC_TRUSTPILOT_REVIEW_COUNT=

# -------------------------------------------
# Admin: test-submission detection
# -------------------------------------------
# Email regex used to flag staff/test submissions in the admin browser.
# Default if unset: ^.+@loveiq\.org$. The bulk-delete admin tool uses
# this PLUS a duration-based check (<= 60s completed or <= 60s partial with
# < 5 answers) to decide which rows are deletable.
# ADMIN_TEST_EMAIL_REGEX=^.+@loveiq\.org$

# -------------------------------------------
# Integration tests (npm run test:integration)
# -------------------------------------------
# These are ONLY read by integration tests in __tests__/integration/. Point
# them at a Supabase BRANCH (NOT production) with the full migration set
# applied. Leave unset to skip integration tests silently (default `npm test`
# is unaffected).
#
# How to get them:
#   1. In Supabase dashboard, open the project → Branching → Create branch.
#   2. From the branch's "Connect" panel, copy:
#        - Project URL          → SUPABASE_TEST_URL
#        - service_role key     → SUPABASE_TEST_SERVICE_ROLE_KEY (webhook-idempotency test)
#        - anon / publishable   → SUPABASE_TEST_ANON_KEY        (RLS-boundary test)
#
# SUPABASE_TEST_URL=https://<branch-id>.supabase.co
# SUPABASE_TEST_SERVICE_ROLE_KEY=eyJ...service-role-jwt
# SUPABASE_TEST_ANON_KEY=eyJ...anon-jwt

# -------------------------------------------
# Company brain (Slack Q&A over our own docs, commits and Jira)
# -------------------------------------------
# The answer model. Written against the OpenAI chat-completions shape, so Gemini,
# Groq, OpenAI or a local Ollama all work by changing these values only.
#
# Currently Gemini, via its OpenAI-compatible endpoint. NOTE: gemini-2.5-flash is
# retired for new API keys (404 "no longer available to new users"), so use a 3.x
# model. Key comes from the loveiq-brain Google Cloud project, no billing attached.
# BRAIN_LLM_KEY=AIza...
# BRAIN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# BRAIN_LLM_MODEL=gemini-3.6-flash
#
# Reasoning budget. Gemini 3.x thinks before answering and those tokens come out
# of max_tokens FIRST — left uncapped a real question measured 13.7s versus 1.7s
# at "low", for the same answer, and a too-small max_tokens returns an EMPTY
# reply with finish_reason "length" rather than an error. Leave unset for any
# provider that rejects unknown parameters; the field is then omitted entirely.
# BRAIN_LLM_REASONING_EFFORT=low
#
# Groq is the drop-in alternative and is better on data grounds — it does not
# train on the prompts it receives, whereas Google's free tier does, and these
# prompts carry our docs, our Jira and our revenue:
#   BRAIN_LLM_BASE_URL=https://api.groq.com/openai/v1
#   BRAIN_LLM_MODEL=groq/compound

# The brain's Slack app. DELIBERATELY SEPARATE from SLACK_BOT_TOKEN above, which
# drives the live journey messages — adding event subscriptions and the im:* scopes
# to that app would force a reinstall and risk breaking a working integration.
# Bot scopes: app_mentions:read, chat:write, im:history, im:read, im:write
# Event subscriptions: app_mention, message.im
# Request URL: https://www.loveiq.org/api/slack/events
# SLACK_BRAIN_BOT_TOKEN=xoxb-...
# SLACK_BRAIN_SIGNING_SECRET=...
# Workspace allowlist. A valid Slack signature proves the request came from
# Slack, NOT that it came from OUR Slack -- and the corpus is deliberately
# undifferentiated (revenue, ad spend, cost per customer, every internal doc),
# so there is no per-source restriction to fall back on. Find it in any event
# payload as `team_id`, or in the Slack app's About page. Left unset the guard is
# OFF, so set it.
# SLACK_BRAIN_TEAM_ID=T0...

# Company brain over MCP, so Claude itself can read the corpus (claude.ai
# connectors, Claude Desktop, and the Code CLI via the committed .mcp.json).
# Any long random string; generate with `openssl rand -hex 32`. Unset => the
# endpoint answers 503, so it is safe to deploy before this exists.
#
# The connector URL must be https://www.loveiq.org/api/mcp — the apex-to-www
# redirect DROPS the Authorization header, which shows up as a baffling 401.
# LOVEIQ_MCP_TOKEN=

# Notion, for the nightly /api/cron/brain-ingest job. Replaces Jira (decision
# 2026-08-28: the team runs its board in Notion, so Jira was dropped rather than
# connected).
#
# WHICH WORKSPACE MATTERS MORE THAN THE TOKEN. The Notion account first connected
# to Claude here was an @aqvc.com one, whose teamspaces were AQVC Labs, Navigate
# Ventures and Asset Management — another company's material, and no LoveIQ
# content at all. This token must belong to the LoveIQ workspace.
#
#   1. notion.so/my-integrations -> New integration -> internal, LoveIQ workspace
#   2. Capabilities: Read content only. It never needs write or user access.
#   3. Copy the Internal Integration Secret (starts ntn_ or secret_)
#   4. In Notion, open the pages/teamspace you want indexed -> ... -> Connections
#      -> add the integration. An integration sees NOTHING until shared this way,
#      which is the real access boundary.
# NOTION_TOKEN=ntn_...
#
# The task board's database id — the `👷🏻‍♂️ Board`. Take it from the database URL:
# app.notion.com/<workspace>/<THIS_IS_THE_ID>?v=... Unset ⇒ pages are indexed but
# the board is not, which loses the Jira-equivalent half.
#
# Advisory only, for the log: Notion's search API has no teamspace filter, so the
# real boundary is which pages the integration was shared with in step 4.
# NOTION_TEAMSPACE_ID=
#
# Comma-separated, case-insensitive substrings of page titles to keep OUT.
#
# DELIBERATELY EMPTY. Notion enforces per-page permissions and the brain does not,
# so anything indexed is readable by anyone who can ask it — including HR,
# performance and onboarding pages that name real people. That was raised on
# 2026-08-28 and the answer was to index everything: LoveIQ runs an open culture
# where everyone can see everything. So this is a settled decision, not an
# oversight, and the exclusion mechanism exists only if that ever changes.
# NOTION_EXCLUDE_TITLES=

# Jira, for the nightly /api/cron/brain-ingest job. Create a token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# The cron no-ops when any of the three is unset.
# JIRA_BASE_URL=https://loveiq.atlassian.net
# JIRA_EMAIL=you@loveiq.org
# JIRA_API_TOKEN=...

# Google Analytics + Search Console for the brain. NO GOOGLE CLOUD PROJECT AND NO
# SERVICE ACCOUNT: these three values come from `gcloud auth application-default
# login`, which uses Google's own OAuth client. Run this once on a laptop (it
# opens a browser), then copy the three fields out of
# ~/.config/gcloud/application_default_credentials.json:
#
# THE OBVIOUS COMMAND IS BLOCKED BY GOOGLE. Do not use gcloud's shared client:
#
#   gcloud auth application-default login --scopes=...analytics.readonly
#
# answers "This app tried to access sensitive info in your Google Account. To keep
# your account safe, Google blocked this access." `analytics.readonly` is a
# sensitive scope and gcloud's shared client id (764086051850-...) may not request
# it. Verified 2026-08-27.
#
# Use your OWN OAuth client, which IS allowed it:
#   1. Cloud console -> project `loveiq-brain` -> APIs & Services -> Credentials
#      -> Create credentials -> OAuth client ID -> Desktop app. The consent
#      screen must be **Internal** (Workspace-only): that removes both the
#      verification requirement and the 7-day refresh-token expiry.
#   2. Download its JSON, then:
#
#        gcloud auth application-default login \
#          --client-id-file=client_secret_....json \
#          --scopes=openid,\
#            https://www.googleapis.com/auth/userinfo.email,\
#            https://www.googleapis.com/auth/cloud-platform,\
#            https://www.googleapis.com/auth/analytics.readonly,\
#            https://www.googleapis.com/auth/webmasters.readonly
#
#   3. Copy client_id / client_secret / refresh_token out of
#      ~/.config/gcloud/application_default_credentials.json into .env.local.
#
# COPY THEM OUT. Any plain `gcloud auth application-default login` in ANY terminal
# on the machine overwrites that file and silently drops the two extra scopes;
# every Google call then answers 403. This happened on 2026-08-27.
#
# The scopes are fixed at login, not at request time — a missing one shows up as
# a 403 ACCESS_TOKEN_SCOPE_INSUFFICIENT on the API call, and the ingester turns
# that into the exact command to re-run.
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
#
# LOCAL-ONLY ALTERNATIVE, no browser and no OAuth client. Service-account
# impersonation, which needs nothing beyond the gcloud CLI:
#
#   export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token \
#     --impersonate-service-account=ga4-reader@loveiq-brain.iam.gserviceaccount.com \
#     --scopes=https://www.googleapis.com/auth/analytics.readonly)
#
# Overrides the three vars above when set. GA4 only — the service account is a
# Viewer on the GA4 property but not a user on Search Console, so GSC still 403s
# until it is added there. The token lasts an hour and gcloud does not exist in a
# serverless function, so this is a laptop convenience, never a deploy credential.
# GOOGLE_OAUTH_ACCESS_TOKEN=

# GA4 numeric property id (GA4 Admin -> Property Settings; NOT the G-XXXX
# measurement id). When Google Ads is linked to this property, ad cost, clicks
# and impressions arrive through the same report — no Google Ads API, and no
# developer token to wait for.
# GA4_PROPERTY_ID=123456789

# Search Console property, exactly as it appears there: a domain property is
# `sc-domain:loveiq.org`, a URL-prefix property is `https://www.loveiq.org/`.
# This is the only source of what people actually typed into Google to find us.
# SEARCH_CONSOLE_SITE=sc-domain:loveiq.org

# Service-account JSON (or base64 of it) for ga4-reader@loveiq-brain.
# PREFERRED over GOOGLE_OAUTH_* below: a Workspace reauth policy invalidates a user
# refresh token every few weeks (invalid_grant / invalid_rapt), which freezes GA4 and
# Search Console until someone clicks a browser prompt. A service account never reauths.
GOOGLE_SERVICE_ACCOUNT_KEY=

# PostHog Personal API Key (phx_...), for the brain's read-only PostHog queries via
# /api/mcp query_external_service. The EU host serves our project (244778); the US
# host rejects the same key. Optional: unset means those queries answer
# "not configured" rather than pretending there is no data.
POSTHOG_API_KEY=

# Optional. The repository is PUBLIC, so the brain reads issues, pull requests and
# CI runs without it; a token only raises the GitHub rate limit.
GITHUB_TOKEN=

# Microsoft Clarity Data Export token (Clarity → Settings → Data Export). Optional:
# lets the brain read session-recording and heatmap metrics — dead clicks, rage clicks,
# JS errors — the only signal we collect about user FRUSTRATION rather than volume.
# Clarity's export API covers the last 1-3 days only, so it is current state, not history.
CLARITY_API_TOKEN=

# Service account to impersonate for Google reads (GA4, Search Console, Drive).
# When set, the GOOGLE_OAUTH_* refresh token needs only the NON-SENSITIVE
# cloud-platform scope: it is exchanged for a service-account token carrying the
# read scopes via iamcredentials.generateAccessToken. That matters because the
# sensitive analytics scopes are refused to some OAuth clients and are what a
# Workspace reauth policy keeps invalidating. Requires the source identity to hold
# roles/iam.serviceAccountTokenCreator on the target account.
# e.g. ga4-reader@loveiq-brain.iam.gserviceaccount.com
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=

# Workload Identity Pool provider path, for KEYLESS Google auth on Vercel.
# Vercel signs an OIDC token into VERCEL_OIDC_TOKEN for every deployment; Google
# trades it for a token of its own, which then impersonates
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT. Nothing is stored, so nothing expires.
# The pool is restricted to one subject (loveiq-web / production), so previews and
# other projects cannot use it. Set on PRODUCTION only.
# //iam.googleapis.com/projects/<num>/locations/global/workloadIdentityPools/vercel/providers/vercel-oidc
GOOGLE_WORKLOAD_IDENTITY_AUDIENCE=

# INJECTED BY VERCEL — do not set this yourself.
# Vercel signs a short-lived OIDC token into this variable for every deployment
# when OIDC federation is on for the project (it is, issuerMode=team). The brain
# trades it for a Google token via GOOGLE_WORKLOAD_IDENTITY_AUDIENCE, so production
# needs no stored Google credential. Absent locally, which is why the refresh-token
# path still exists.
VERCEL_OIDC_TOKEN=

# Mailboxes the company-brain Gmail ingester reads, comma-separated. Unset means
# "me" — whoever the Google credential belongs to. Reading a COLLEAGUE's mail needs
# Workspace domain-wide delegation, not just this list: a user OAuth token only ever
# reaches its own mailbox, whatever scope it carries.
# GMAIL_MAILBOXES=ec@loveiq.org,marcus@loveiq.org
# Mailboxes to leave OUT of the walk, whatever the directory returns. Discovery drops
# SUSPENDED accounts already; this covers a colleague who has left while their account
# is still live, or mail simply not wanted in the corpus. Case and padding insensitive.
# Excluding does NOT delete indexed history — the sweep spares any mailbox not walked.
# GMAIL_EXCLUDE_MAILBOXES=someone@loveiq.org

# Workspace domain-wide delegation, for reading EVERY colleague's mail rather than
# only the credential's own. Both are required, and so is authorising the service
# account's client id in admin.google.com with gmail.readonly AND
# admin.directory.user.readonly. The directory is asked as this admin because an
# ordinary user is refused; the mailbox list is then discovered rather than
# maintained by hand, so it cannot go stale when somebody joins or leaves.
# GOOGLE_WORKSPACE_ADMIN=ec@loveiq.org
# GOOGLE_WORKSPACE_DOMAIN=loveiq.org

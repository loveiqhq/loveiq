{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@features/*": ["./features/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    // `**/*.ts` does NOT match `.mts`, so scripts/preview-slack-message.mts was
    // never typechecked — it builds the same DigestInput the cron does, from its
    // own copy of the fetch list, and a required field added to that input did
    // not fail its build because it had no build. Same class as the docs:check
    // glob that skips .mjs.
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `supabase/functions` is DENO, not Next.js: it imports from `jsr:` and uses
  // the `Deno` global, neither of which exists in this compilation unit. It is
  // deployed by the Supabase CLI, which typechecks it with Deno's own toolchain.
  "exclude": [
    "node_modules",
    "__tests__",
    "features/**/tests",
    "shared/**/tests",
    "supabase/functions"
  ]
}

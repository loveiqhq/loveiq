{
  "name": "loveiq-web",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docs:truth": "node scripts/check-docs-truth.mjs",
    "check:migration-drift": "node scripts/check-migration-drift.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true npm run build",
    "check": "npm run lint && npm test && npm run build",
    "generate:practice-tendencies": "node scripts/generate-practice-tendencies.js",
    "scoring:extract": "python scripts/extract-scoring-xlsm.py",
    "scoring:update": "python scripts/extract-scoring-xlsm.py && node scripts/update-scoring-config.js",
    "setup": "npm install && node -e \"const fs=require('fs');if(!fs.existsSync('.env.local')){fs.copyFileSync('.env.example','.env.local');console.log('.env.local created from .env.example')}else{console.log('.env.local already exists')}\"",
    "update:product-kpis": "node scripts/update-product-kpis.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/redis": "^1.37.0",
    "@vercel/otel": "^2.1.2",
    "lenis": "^1.3.23",
    "next": "^16.2.4",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.0",
    "stripe": "^22.0.1",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "csv-parse": "^6.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "mammoth": "^1.12.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "glob": "^10.5.0",
    "minimatch": ">=10.2.1",
    "postcss": "$postcss",
    "uuid": ">=11.0.0",
    "vite": "8.0.5",
    "yaml": ">=2.8.3"
  }
}

{
  "name": "loveiq-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docs:truth": "node scripts/check-docs-truth.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint \"**/*.md\" --no-progress --no-must-find-files",
    "docs:check": "npm run docs:truth && npm run docs:lint && npm run docs:spell && prettier --check \"**/*.md\"",
    "check:migration-drift": "node scripts/check-migration-drift.mjs",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "survey:check-db-sync": "node scripts/check-survey-db-sync.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:safe": "vitest run --config vitest.integration.config.ts __tests__/integration/rls-boundary.integration.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=\"Desktop Chrome\" e2e/visual-regression.spec.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "audit:high": "npm audit --audit-level=high",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --ignore-npm-errors --output-file sbom.json",
    "lighthouse:local": "npx @lhci/cli@latest autorun --config=lighthouserc.json",
    "k6:smoke": "k6 run -e BASE_URL=${BASE_URL:-http://localhost:3000} load-tests/smoke.js",
    "k6:load": "k6 run -e BASE_URL=${BASE_URL:-http://localhost:3000} load-tests/load.js",
    "k6:spike": "k6 run -e BASE_URL=${BASE_URL:-http://localhost:3000} load-tests/spike.js",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:quick": "QUICK=1 bash scripts/ci-local.sh",
    "ci:local:full": "FULL=1 bash scripts/ci-local.sh",
    "analyze": "ANALYZE=true npm run build",
    "check": "npm run lint && npm test && npm run docs:check && npm run build",
    "generate:practice-tendencies": "node scripts/generate-practice-tendencies.js",
    "scoring:extract": "python scripts/extract-scoring-xlsm.py",
    "scoring:update": "python scripts/extract-scoring-xlsm.py && node scripts/update-scoring-config.js",
    "setup": "npm install && node -e \"const fs=require('fs');if(!fs.existsSync('.env.local')){fs.copyFileSync('.env.example','.env.local');console.log('.env.local created from .env.example')}else{console.log('.env.local already exists')}\"",
    "update:product-kpis": "node scripts/update-product-kpis.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/redis": "^1.38.0",
    "@vercel/otel": "^2.1.3",
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "lenis": "^1.3.25",
    "next": "^16.2.12",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.16.0",
    "stripe": "^22.1.1",
    "svix": "^1.96.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "cspell": "9.8.0",
    "csv-parse": "^6.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.0.7",
    "mammoth": "^1.12.0",
    "markdownlint-cli2": "0.23.2",
    "msw": "^2.14.6",
    "postcss": "^8.5.25",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "glob": "^10.5.0",
    "minimatch": ">=10.2.1",
    "postcss": "$postcss",
    "uuid": ">=11.0.0",
    "vite": "^8.0.16",
    "js-yaml": ">=5.2.2",
    "markdown-it": ">=14.2.0",
    "yaml": ">=2.8.3",
    "sharp": ">=0.35.3",
    "brace-expansion": ">=5.0.9",
    "linkify-it": ">=5.0.2"
  }
}

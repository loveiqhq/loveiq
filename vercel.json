{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/survey-paused",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/nurture-sequence",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/invite-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/payment-fulfillment-sweep",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/abandoned-checkout-alert",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/deep-engagement-alert",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/security-storm-detector",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/funnel-digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/anomaly-watcher",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/product-digest",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/cron/tech-digest",
      "schedule": "10 9 * * *"

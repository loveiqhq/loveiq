{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/survey-paused",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/report-discount-email",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/invite-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/payment-fulfillment-sweep",
      "schedule": "*/30 * * * *"
    }
  ],
  "functions": {
    "app/api/stripe/webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/survey-paused/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/report-discount-email/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/invite-reminders/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/payment-fulfillment-sweep/route.ts": {
      "maxDuration": 60
    }
  }
}

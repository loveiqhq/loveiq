    "app/api/cron/survey-paused/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/nurture-sequence/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/invite-reminders/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/payment-fulfillment-sweep/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/abandoned-checkout-alert/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/deep-engagement-alert/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/security-storm-detector/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/funnel-digest/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/anomaly-watcher/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/product-digest/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/tech-digest/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/purge-old-data/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/table-size-digest/route.ts": {
      "maxDuration": 30
    }
